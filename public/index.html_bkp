<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Ollama Chat</title>

<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.8/dist/purify.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/atom-one-dark.min.css">
<script src="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/highlight.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
<script src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>

<style>
  :root {
    --bg: #171717; --bg-alt: #212121; --bg-hover: #2a2a2a; --border: #2f2f2f;
    --text: #ececec; --text-dim: #a0a0a0; --accent: #2563eb; --accent-hover: #1d4ed8;
    --thinking-bg: #1e1e2e; --thinking-border: #4c4f69; --code-bg: #0d1117;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: var(--bg); color: var(--text); overflow: hidden; }
  .app { display: flex; height: 100vh; }
  .sidebar { width: 260px; background: var(--bg-alt); border-right: 1px solid var(--border); display: flex; flex-direction: column; transition: margin-left 0.2s; }
  .sidebar.hidden { margin-left: -260px; }
  .sidebar-header { padding: 12px; border-bottom: 1px solid var(--border); }
  .new-chat-btn { width: 100%; padding: 10px; background: transparent; color: var(--text); border: 1px solid var(--border); border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 14px; transition: background 0.15s; }
  .new-chat-btn:hover { background: var(--bg-hover); }
  .chat-list { flex: 1; overflow-y: auto; padding: 8px; }
  .chat-item { padding: 10px 12px; border-radius: 8px; cursor: pointer; font-size: 14px; color: var(--text-dim); margin-bottom: 2px; display: flex; justify-content: space-between; align-items: center; transition: background 0.15s; }
  .chat-item:hover, .chat-item.active { background: var(--bg-hover); color: var(--text); }
  .chat-item .title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .chat-item .del { opacity: 0; background: none; border: none; color: var(--text-dim); cursor: pointer; padding: 2px 6px; border-radius: 4px; }
  .chat-item:hover .del { opacity: 1; }
  .chat-item .del:hover { background: #3a3a3a; color: #ff6b6b; }
  .main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .topbar { padding: 10px 16px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; background: var(--bg); }
  .icon-btn { background: transparent; border: none; color: var(--text-dim); cursor: pointer; padding: 6px 8px; border-radius: 6px; font-size: 16px; }
  .icon-btn:hover { background: var(--bg-hover); color: var(--text); }
  .model-select { background: var(--bg-alt); color: var(--text); border: 1px solid var(--border); padding: 6px 10px; border-radius: 6px; font-size: 14px; cursor: pointer; max-width: 260px; }
  .topbar .spacer { flex: 1; }
  .status { font-size: 12px; color: var(--text-dim); }
  .chat-area { flex: 1; overflow-y: auto; padding: 20px 0; }
  .messages { max-width: 820px; margin: 0 auto; padding: 0 20px; }
  .empty-state { text-align: center; padding: 80px 20px; color: var(--text-dim); }
  .empty-state h1 { font-size: 28px; margin-bottom: 8px; color: var(--text); }
  .empty-state p { font-size: 14px; }
  .message { margin-bottom: 24px; display: flex; gap: 12px; }
  .avatar { width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 600; }
  .avatar.user { background: #4a5568; color: white; }
  .avatar.assistant { background: #10a37f; color: white; }
  .msg-body { flex: 1; min-width: 0; }
  .msg-role { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
  .msg-content { line-height: 1.65; font-size: 15px; word-wrap: break-word; }
  .msg-content p { margin: 0.6em 0; }
  .msg-content p:first-child { margin-top: 0; }
  .msg-content p:last-child { margin-bottom: 0; }
  .msg-content h1, .msg-content h2, .msg-content h3 { margin: 1em 0 0.5em; }
  .msg-content ul, .msg-content ol { margin: 0.6em 0; padding-left: 1.6em; }
  .msg-content li { margin: 0.2em 0; }
  .msg-content blockquote { border-left: 3px solid var(--border); padding-left: 12px; color: var(--text-dim); margin: 0.6em 0; }
  .msg-content a { color: #60a5fa; text-decoration: none; }
  .msg-content a:hover { text-decoration: underline; }
  .msg-content table { border-collapse: collapse; margin: 0.6em 0; }
  .msg-content th, .msg-content td { border: 1px solid var(--border); padding: 6px 10px; }
  .msg-content th { background: var(--bg-alt); }
  .msg-content hr { border: none; border-top: 1px solid var(--border); margin: 1em 0; }
  .msg-content strong { font-weight: 600; }
  .msg-content code:not(pre code) { background: var(--code-bg); padding: 2px 6px; border-radius: 4px; font-family: "SF Mono", Monaco, Consolas, monospace; font-size: 0.9em; color: #e06c75; }
  .code-block { margin: 0.8em 0; border-radius: 8px; overflow: hidden; background: var(--code-bg); border: 1px solid var(--border); }
  .code-header { background: #161b22; padding: 6px 12px; font-size: 12px; color: var(--text-dim); display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); }
  .code-header button { background: transparent; border: none; color: var(--text-dim); cursor: pointer; font-size: 12px; padding: 2px 8px; border-radius: 4px; }
  .code-header button:hover { background: #2a2a2a; color: var(--text); }
  .code-block pre { margin: 0; padding: 12px; overflow-x: auto; }
  .code-block pre code { font-family: "SF Mono", Monaco, Consolas, monospace; font-size: 13px; line-height: 1.5; background: transparent; padding: 0; }
  .thinking-block { margin: 0.6em 0; border: 1px solid var(--thinking-border); border-radius: 8px; background: var(--thinking-bg); overflow: hidden; }
  .thinking-header { padding: 8px 12px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 13px; color: #cdd6f4; user-select: none; }
  .thinking-header:hover { background: rgba(255,255,255,0.03); }
  .thinking-header .arrow { transition: transform 0.2s; font-size: 10px; }
  .thinking-block.open .thinking-header .arrow { transform: rotate(90deg); }
  .thinking-header .label { font-weight: 600; }
  .thinking-header .status-dot { width: 6px; height: 6px; border-radius: 50%; background: #f9e2af; animation: pulse 1.2s infinite; }
  .thinking-block.done .status-dot { background: #a6e3a1; animation: none; }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  .thinking-content { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; border-top: 1px solid transparent; }
  .thinking-block.open .thinking-content { max-height: 2000px; border-top-color: var(--thinking-border); }
  .thinking-content .inner { padding: 10px 14px; font-size: 13.5px; color: #bac2de; line-height: 1.6; max-height: 400px; overflow-y: auto; }
  .thinking-content .inner p { margin: 0.4em 0; }
  .msg-actions { display: flex; gap: 4px; margin-top: 6px; opacity: 0; transition: opacity 0.15s; }
  .message:hover .msg-actions { opacity: 1; }
  .msg-actions button { background: transparent; border: none; color: var(--text-dim); cursor: pointer; padding: 4px 6px; border-radius: 4px; font-size: 13px; }
  .msg-actions button:hover { background: var(--bg-hover); color: var(--text); }
  .switch { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-dim); cursor: pointer; user-select: none; padding: 4px 8px; border-radius: 6px; }
  .switch:hover { background: var(--bg-hover); color: var(--text); }
  .switch input { position: absolute; opacity: 0; pointer-events: none; }
  .switch .track { width: 32px; height: 18px; background: #3a3a3a; border-radius: 999px; position: relative; transition: background 0.2s; flex-shrink: 0; }
  .switch .track::after { content: ''; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 50%; background: #fff; transition: transform 0.2s; }
  .switch input:checked + .track { background: var(--accent); }
  .switch input:checked + .track::after { transform: translateX(14px); }
  .switch input:focus-visible + .track { outline: 2px solid #60a5fa; outline-offset: 2px; }
  .msg-stats { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; font-size: 12px; }
  .msg-stats:empty { display: none; }
  .stat { display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 999px; background: var(--bg-alt); border: 1px solid var(--border); color: var(--text-dim); cursor: default; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .stat b { color: var(--text); font-weight: 600; }
  .stat.speed { border-color: #1f6f55; }
  .stat.speed b { color: #34d399; }
  .stat.warn { border-color: #92400e; color: #fbbf24; }
  .stat.live .dot { width: 6px; height: 6px; border-radius: 50%; background: #34d399; animation: pulse 1.2s infinite; }
  .input-area { padding: 12px 20px 20px; background: var(--bg); }
  .input-wrap { max-width: 820px; margin: 0 auto; background: var(--bg-alt); border: 1px solid var(--border); border-radius: 12px; padding: 8px; display: flex; gap: 8px; align-items: flex-end; }
  .input-wrap:focus-within { border-color: #444; }
  #prompt { flex: 1; background: transparent; border: none; color: var(--text); font-size: 15px; resize: none; outline: none; padding: 8px; font-family: inherit; max-height: 240px; line-height: 1.5; }
  .send-btn { background: var(--accent); color: white; border: none; width: 36px; height: 36px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 16px; transition: background 0.15s; }
  .send-btn:hover { background: var(--accent-hover); }
  .send-btn.stop { background: #dc2626; }
  .send-btn.stop:hover { background: #b91c1c; }
  .input-hint { text-align: center; font-size: 11px; color: var(--text-dim); margin-top: 6px; }
  .cursor { display: inline-block; width: 8px; height: 16px; background: var(--text); vertical-align: middle; animation: blink 1s infinite; margin-left: 2px; }
  @keyframes blink { 0%,50% { opacity: 1; } 51%,100% { opacity: 0; } }
  ::-webkit-scrollbar { width: 8px; height: 8px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #3a3a3a; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #4a4a4a; }
  @media (max-width: 768px) { .sidebar { position: absolute; z-index: 10; height: 100%; } }
</style>
</head>
<body>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
      <button class="new-chat-btn" onclick="newChat()"><span>&#10010;</span> New Chat</button>
    </div>
    <div class="chat-list" id="chatList"></div>
  </aside>
  <main class="main">
    <div class="topbar">
      <button class="icon-btn" onclick="toggleSidebar()" title="Toggle sidebar">&#9776;</button>
      <select class="model-select" id="modelSelect"></select>
      <button class="icon-btn" onclick="refreshModels()" title="Refresh models">&#8635;</button>
      <label class="switch" title="When off, the request sends think:false so the model answers directly without reasoning">
        <input type="checkbox" id="thinkToggle" checked>
        <span class="track"></span>
        <span>Thinking</span>
      </label>
      <div class="spacer"></div>
      <span class="status" id="status"></span>
    </div>
    <div class="chat-area" id="chatArea">
      <div class="messages" id="messages"></div>
    </div>
    <div class="input-area">
      <div class="input-wrap">
        <textarea id="prompt" placeholder="Message Ollama..." rows="1"></textarea>
        <button class="send-btn" id="sendBtn" onclick="handleSend()" title="Send">&#9654;</button>
      </div>
      <div class="input-hint">Press Enter to send &middot; Shift+Enter for newline</div>
    </div>
  </main>
</div>

<script>
// Chats are stored in SQLite by the Node server (server.js); Ollama is reached through its /ollama proxy.
const OLLAMA_URL = '/ollama';

let chats = [];
let currentChatId = null;
let isGenerating = false;
let abortController = null;
let stickToBottom = true;

// Highlighting is done after render with hljs (marked removed its `highlight` option).
marked.setOptions({ breaks: true, gfm: true });

async function api(method, path, body) {
  const r = await fetch('/api' + path, { method, headers: { 'Content-Type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
  if (!r.ok) throw new Error('HTTP ' + r.status);
  return r.json();
}
function persist(chat) {
  const messages = chat.messages
    .filter(m => !m.streaming && (m.role === 'user' || m.content || m.thinking))
    .map(m => {
      const stats = m.stats ? { ...m.stats } : undefined;
      if (stats && m._tFirst && m._t0) stats.ttft = (m._tFirst - m._t0) / 1000;
      return { role: m.role, content: m.content, thinking: m.thinking || '', model: m.model, stats };
    });
  return api('PUT', '/chats/' + chat.id, { title: chat.title, model: chat.model, created: chat.created, messages })
    .catch(e => console.error('Save failed:', e));
}
function getChat(id) { return chats.find(c => c.id === id); }
function currentChat() { return getChat(currentChatId); }
function safeRender() { try { renderMessages(); } catch (e) { console.error('Render failed:', e); } }

function newChat() {
  // Reuse an existing blank chat instead of piling up empty ones
  const blank = chats.find(c => c.loaded && c.messages.length === 0);
  if (blank) { switchChat(blank.id); return; }
  const chat = {
    id: 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
    title: 'New Chat', messages: [], loaded: true,
    model: document.getElementById('modelSelect').value, created: Date.now()
  };
  chats.unshift(chat); // saved to the DB when the first message is sent
  switchChat(chat.id);
}
async function switchChat(id) {
  currentChatId = id; stickToBottom = true;
  const chat = getChat(id);
  renderChatList();
  if (chat && !chat.loaded) {
    try {
      const full = await api('GET', '/chats/' + id);
      chat.messages = full.messages; chat.model = full.model || chat.model;
    } catch (e) { console.error('Load failed:', e); }
    chat.loaded = true;
    if (currentChatId !== id) return;
  }
  const sel = document.getElementById('modelSelect');
  if (chat && chat.model && [...sel.options].some(o => o.value === chat.model)) sel.value = chat.model;
  renderMessages();
}
function deleteChat(id, ev) {
  ev.stopPropagation();
  if (!confirm('Delete this chat?')) return;
  chats = chats.filter(c => c.id !== id);
  api('DELETE', '/chats/' + id).catch(e => console.error('Delete failed:', e));
  if (currentChatId === id) {
    currentChatId = chats[0]?.id || null;
    if (!currentChatId) { newChat(); return; }
    switchChat(currentChatId);
  }
  renderChatList();
}
function renderChatList() {
  const list = document.getElementById('chatList'); list.innerHTML = '';
  chats.forEach(c => {
    const el = document.createElement('div');
    el.className = 'chat-item' + (c.id === currentChatId ? ' active' : '');
    el.onclick = () => switchChat(c.id);
    el.innerHTML = `<span class="title">${escapeHtml(c.title)}</span><button class="del" title="Delete">&#10005;</button>`;
    el.querySelector('.del').onclick = (e) => deleteChat(c.id, e);
    list.appendChild(el);
  });
}

async function refreshModels() {
  const sel = document.getElementById('modelSelect'); const status = document.getElementById('status');
  status.textContent = 'Loading models...';
  try {
    const res = await fetch(`${OLLAMA_URL}/api/tags`);
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    const models = (data.models || []).sort((a, b) => a.name.localeCompare(b.name));
    const prev = sel.value; sel.innerHTML = '';
    if (models.length === 0) sel.innerHTML = '<option value="">No models found</option>';
    else models.forEach(m => { const o = document.createElement('option'); o.value = m.name; o.textContent = m.name; sel.appendChild(o); });
    if (prev && models.find(m => m.name === prev)) sel.value = prev;
    status.textContent = `${models.length} model${models.length !== 1 ? 's' : ''}`;
  } catch (e) {
    status.textContent = 'Cannot reach Ollama';
    sel.innerHTML = '<option value="">Connection error</option>';
  }
}

function renderMessages() {
  const chat = currentChat(); const container = document.getElementById('messages'); container.innerHTML = '';
  if (!chat || chat.messages.length === 0) { container.appendChild(createEmptyState()); return; }
  chat.messages.forEach((m, idx) => container.appendChild(renderMessage(m, idx)));
  scrollToBottom();
}
function createEmptyState() {
  const d = document.createElement('div'); d.className = 'empty-state'; d.id = 'emptyState';
  d.innerHTML = '<h1>Ollama Chat</h1><p>Ask anything. Pick a model above and start typing.</p>';
  return d;
}

function renderMessage(m, idx) {
  const el = document.createElement('div'); el.className = 'message'; el.dataset.idx = idx;
  const isUser = m.role === 'user';
  el.innerHTML = `
    <div class="avatar ${m.role}">${isUser ? 'U' : 'A'}</div>
    <div class="msg-body">
      <div class="msg-role">${isUser ? 'You' : escapeHtml(m.model || 'Assistant')}</div>
      <div class="msg-content"></div>
      <div class="msg-stats"></div>
      <div class="msg-actions">
        <button onclick="copyMessage(${idx}, this)" title="Copy">&#128203; Copy</button>
        ${!isUser ? `<button onclick="regenerate(${idx})" title="Regenerate">&#8635; Regenerate</button>` : ''}
      </div>
    </div>`;
  const contentEl = el.querySelector('.msg-content');
  if (isUser) { contentEl.textContent = m.content; contentEl.style.whiteSpace = 'pre-wrap'; }
  else {
    renderAssistantContent(contentEl, m.content, m.thinking, m.streaming, m);
    renderStats(el.querySelector('.msg-stats'), m);
  }
  return el;
}

function codeBlockHtml(classes, codeContent) {
  const langMatch = (classes || '').match(/language-([^\s]+)/);
  const lang = langMatch ? langMatch[1] : 'text';
  const cls = classes ? ` class="${classes}"` : '';
  return `<div class="code-block"><div class="code-header"><span>${escapeHtml(lang)}</span><button onclick="copyCode(this)">&#128203; Copy</button></div><pre><code${cls}>${codeContent}</code></pre></div>`;
}

function renderAssistantContent(el, content, thinking, streaming, state) {
  state = state || {};

  // Persistent structure: [thinking block] + [answer body]. Both are reused between
  // renders so scroll positions, text selection and open/closed state survive streaming.
  let body = el.querySelector(':scope > .answer-body');
  if (!body) {
    el.innerHTML = '';
    body = document.createElement('div'); body.className = 'answer-body';
    el.appendChild(body);
  }
  let block = el.querySelector(':scope > .thinking-block');

  // 1. Thinking block
  if (thinking) {
    if (!block) {
      block = document.createElement('div');
      block.className = 'thinking-block';
      block.innerHTML = '<div class="thinking-header"><span class="arrow">&#9654;</span><span class="status-dot"></span><span class="label"></span></div><div class="thinking-content"><div class="inner"></div></div>';
      block.querySelector('.thinking-header').onclick = () => {
        state._thinkOpen = block.classList.toggle('open');
      };
      el.insertBefore(block, body);
    }
    const isOpen = state._thinkOpen !== undefined ? state._thinkOpen : !!streaming;
    block.classList.toggle('open', isOpen);
    block.classList.toggle('done', !streaming);
    block.querySelector('.label').textContent = streaming ? 'Thinking…' : 'Thought process';

    if (block._thinking !== thinking) {
      const inner = block.querySelector('.inner');
      // Follow the stream only if the reader is already at the bottom
      const atBottom = inner.scrollHeight - inner.scrollTop - inner.clientHeight < 30;
      const prev = inner.scrollTop;
      inner.innerHTML = DOMPurify.sanitize(marked.parse(thinking));
      inner.scrollTop = atBottom ? inner.scrollHeight : prev;
      block._thinking = thinking;
    }
  } else if (block) {
    block.remove();
  }

  // 2. Answer body (only rebuilt when it actually changed)
  const key = (content || '') + '|' + (streaming ? 1 : 0);
  if (body._key !== key) {
    body._key = key;
    body.innerHTML = '';
    if (content) {
      let html = DOMPurify.sanitize(marked.parse(content));

      html = html.replace(/<pre><code(?: class="([^"]*)")?>([\s\S]*?)<\/code><\/pre>/gi,
        (m, classes, code) => codeBlockHtml(classes, code));

      if (streaming) {
        html = html.replace(/<pre><code(?: class="([^"]*)")?>([\s\S]*)$/i,
          (m, classes, code) => codeBlockHtml(classes, code));
      }

      const wrap = document.createElement('div');
      wrap.innerHTML = html;

      wrap.querySelectorAll('pre code').forEach(b => { try { hljs.highlightElement(b); } catch (e) {} });

      try {
        renderMathInElement(wrap, {
          delimiters: [
            { left: '$$', right: '$$', display: true }, { left: '\\[', right: '\\]', display: true },
            { left: '\\(', right: '\\)', display: false }, { left: '$', right: '$', display: false }
          ],
          throwOnError: false,
          ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code']
        });
      } catch (e) {}

      while (wrap.firstChild) body.appendChild(wrap.firstChild);
    }
  }

  // 3. Cursor while waiting for the first answer token
  el.querySelectorAll('.cursor').forEach(c => c.remove());
  if (streaming && (!content || content.trim() === '')) {
    const cur = document.createElement('span'); cur.className = 'cursor'; body.appendChild(cur);
  }
}

async function handleSend() {
  if (isGenerating) { stopGeneration(); return; }
  const prompt = document.getElementById('prompt'); const text = prompt.value.trim();
  if (!text) return;
  const model = document.getElementById('modelSelect').value;
  if (!model) { alert('Please select a model.'); return; }

  let chat = currentChat();
  if (!chat) { newChat(); chat = currentChat(); }
  chat.model = model;

  chat.messages.push({ role: 'user', content: text });
  if (chat.messages.length === 1) chat.title = text.slice(0, 50) + (text.length > 50 ? '…' : '');
  prompt.value = ''; autoResize(prompt); renderChatList(); stickToBottom = true;
  persist(chat);

  chat.messages.push({ role: 'assistant', content: '', thinking: '', model, streaming: true });
  safeRender();

  await streamChat(chat);
}

async function streamChat(chat) {
  isGenerating = true; updateSendButton(); abortController = new AbortController();
  const model = chat.model;
  // History without the in-progress assistant message and without thinking text
  const messages = chat.messages
    .filter(m => m.role === 'user' || m.role === 'assistant')
    .slice(0, -1)
    .filter(m => m.content)
    .map(m => ({ role: m.role, content: m.content }));
  const assistantMsg = chat.messages[chat.messages.length - 1];
  assistantMsg._t0 = performance.now(); assistantMsg._tFirst = null; assistantMsg._tEnd = null; assistantMsg._chunks = 0;

  // Thinking switch: off -> think:false. On -> leave the field out (default), which also
  // avoids errors on models that don't support thinking.
  const think = document.getElementById('thinkToggle').checked;
  const payload = { model, messages, stream: true };
  if (!think) payload.think = false;

  try {
    const res = await fetch(`${OLLAMA_URL}/api/chat`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload), signal: abortController.signal
    });
    if (!res.ok) throw new Error('HTTP ' + res.status + ': ' + await res.text());

    const reader = res.body.getReader(); const decoder = new TextDecoder(); let buffer = '';

    while (true) {
      const { done, value } = await reader.read(); if (done) break;
      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split('\n'); buffer = lines.pop();
      for (const line of lines) {
        if (!line.trim()) continue;
        let data;
        try { data = JSON.parse(line); } catch (e) { console.error('Parse error:', line, e); continue; }

        if (data.error) throw new Error(data.error);

        if (data.message) {
          // Newer Ollama sends reasoning in a separate field
          if (data.message.thinking && think) {
            assistantMsg._apiThinking = (assistantMsg._apiThinking || '') + data.message.thinking;
            syncThinking(assistantMsg);
          }
          if (data.message.content) processContent(assistantMsg, data.message.content);
          if (!think) assistantMsg.thinking = '';
          if ((data.message.content || data.message.thinking) && !data.done) {
            if (assistantMsg._tFirst === null) assistantMsg._tFirst = performance.now();
            assistantMsg._chunks++;
          }
          updateStreamingMessage(chat);
        }
        if (data.done) {
          assistantMsg._tEnd = performance.now();
          assistantMsg.stats = {
            total_duration: data.total_duration, load_duration: data.load_duration,
            prompt_eval_count: data.prompt_eval_count, prompt_eval_duration: data.prompt_eval_duration,
            eval_count: data.eval_count, eval_duration: data.eval_duration,
            done_reason: data.done_reason
          };
          console.log('Stream complete. Final content:', assistantMsg.content, assistantMsg.stats);
        }
      }
    }
    assistantMsg.streaming = false; safeRender();
  } catch (e) {
    assistantMsg.streaming = false;
    assistantMsg._tEnd = performance.now();
    if (e.name === 'AbortError') {
      console.log('Aborted.');
    } else {
      console.error('Stream failed:', e);
      assistantMsg.content = (assistantMsg.content ? assistantMsg.content + '\n\n' : '') + `**Error:** ${e.message}`;
    }
    safeRender();
  } finally {
    isGenerating = false; abortController = null; updateSendButton();
    persist(chat);
  }
}

function syncThinking(msg) {
  msg.thinking = [msg._apiThinking, msg._tagThinking].filter(Boolean).join('\n\n');
}

// Handles models that put <think>...</think> inside the content stream
function processContent(msg, chunk) {
  msg._raw = (msg._raw || '') + chunk;
  const raw = msg._raw;

  const parts = [];
  const re = /<think>([\s\S]*?)<\/think>/gi;
  let m;
  while ((m = re.exec(raw)) !== null) parts.push(m[1]);

  let cleaned = raw.replace(/<think>[\s\S]*?<\/think>/gi, '');
  const openIdx = cleaned.toLowerCase().indexOf('<think>');
  if (openIdx !== -1) {
    parts.push(cleaned.slice(openIdx + 7));
    cleaned = cleaned.slice(0, openIdx);
  }
  msg.content = cleaned.trim();
  msg._tagThinking = parts.join('\n\n').trim();
  syncThinking(msg);
}

function updateStreamingMessage(chat) {
  const lastMsg = document.getElementById('messages').lastElementChild;
  if (!lastMsg) return;
  const assistantMsg = chat.messages[chat.messages.length - 1];
  const contentEl = lastMsg.querySelector('.msg-content');
  if (!contentEl) return;
  try { renderAssistantContent(contentEl, assistantMsg.content, assistantMsg.thinking, true, assistantMsg); } catch (e) { console.error(e); }
  renderStats(lastMsg.querySelector('.msg-stats'), assistantMsg);
  scrollToBottom();
}

function fmtDur(sec) { return sec < 1 ? Math.round(sec * 1000) + ' ms' : sec.toFixed(2) + ' s'; }

function buildStats(msg) {
  const s = msg.stats || {};
  const chips = [];
  const live = !!msg.streaming;
  const now = msg._tEnd || performance.now();
  const hasApi = s.eval_count && s.eval_duration;

  // Generation speed: exact from Ollama when finished, estimated from chunks while streaming/aborted
  if (hasApi) {
    chips.push({ cls: 'speed', value: (s.eval_count / (s.eval_duration / 1e9)).toFixed(1), label: 'tok/s', title: 'Generation speed (eval_count / eval_duration)' });
  } else if (msg._chunks > 1 && msg._tFirst) {
    const el = (now - msg._tFirst) / 1000;
    if (el > 0.3) chips.push({ cls: 'speed' + (live ? ' live' : ''), value: '~' + (msg._chunks / el).toFixed(1), label: 'tok/s', title: 'Estimated from streamed chunks' });
  }

  if (hasApi) chips.push({ value: s.eval_count, label: 'output tokens', title: 'Tokens generated' });
  else if (msg._chunks) chips.push({ value: '~' + msg._chunks, label: 'tokens', title: 'Estimated from streamed chunks' });

  if (s.prompt_eval_count) {
    const pSpeed = s.prompt_eval_duration ? (s.prompt_eval_count / (s.prompt_eval_duration / 1e9)).toFixed(0) + ' tok/s' : '';
    chips.push({ value: s.prompt_eval_count, label: 'prompt tokens', title: 'Prompt tokens processed' + (pSpeed ? ' at ' + pSpeed : '') });
  }

  const ttft = (msg._tFirst && msg._t0) ? (msg._tFirst - msg._t0) / 1000 : s.ttft;
  if (ttft != null) chips.push({ value: fmtDur(ttft), label: 'to first token', title: 'Time from sending the request to the first streamed token' });

  if (s.total_duration) chips.push({ value: fmtDur(s.total_duration / 1e9), label: 'total', title: 'Total duration reported by Ollama' });
  else if (msg._t0 && (msg._tEnd || live)) chips.push({ value: fmtDur((now - msg._t0) / 1000), label: 'elapsed', title: 'Elapsed time measured in the browser' });

  if (s.load_duration && s.load_duration / 1e9 >= 0.1) chips.push({ value: fmtDur(s.load_duration / 1e9), label: 'model load', title: 'Time spent loading the model into memory' });

  if (s.done_reason === 'length') chips.push({ cls: 'warn', value: 'Truncated', label: '', title: 'Stopped because the token limit or context window was reached' });
  else if (!live && !hasApi && msg._tEnd && msg.content) chips.push({ cls: 'warn', value: 'Stopped early', label: '', title: 'Generation was interrupted, so these numbers are estimates' });

  return chips;
}

function renderStats(el, msg) {
  if (!el) return;
  const live = !!msg.streaming;
  el.innerHTML = buildStats(msg).map(c =>
    `<span class="stat ${c.cls || ''}" title="${escapeHtml(c.title || '')}">${c.cls && c.cls.includes('live') ? '<span class="dot"></span>' : ''}<b>${escapeHtml(c.value)}</b>${c.label ? ' ' + escapeHtml(c.label) : ''}</span>`
  ).join('');
}

function stopGeneration() {
  if (abortController) abortController.abort();
}

function updateSendButton() {
  const btn = document.getElementById('sendBtn');
  if (isGenerating) { btn.innerHTML = '&#9632;'; btn.classList.add('stop'); btn.title = 'Stop'; }
  else { btn.innerHTML = '&#9654;'; btn.classList.remove('stop'); btn.title = 'Send'; }
}

function copyMessage(idx, btn) {
  const m = currentChat().messages[idx];
  const text = (m.thinking ? `[Thinking]\n${m.thinking}\n\n` : '') + m.content;
  navigator.clipboard.writeText(text); flashCopied(btn);
}
function regenerate(idx) {
  if (isGenerating) return;
  const chat = currentChat();
  chat.messages.splice(idx, 1);
  chat.messages.push({ role: 'assistant', content: '', thinking: '', model: chat.model, streaming: true });
  safeRender(); streamChat(chat);
}
function copyCode(btn) {
  const code = btn.closest('.code-block').querySelector('pre code');
  navigator.clipboard.writeText(code.textContent);
  flashCopied(btn);
}
function flashCopied(el) {
  const orig = el.innerHTML; el.innerHTML = '&#10003; Copied';
  setTimeout(() => el.innerHTML = orig, 1500);
}

function toggleSidebar() { document.getElementById('sidebar').classList.toggle('hidden'); }
function scrollToBottom() { if (!stickToBottom) return; const a = document.getElementById('chatArea'); a.scrollTop = a.scrollHeight; }
function autoResize(el) { el.style.height = 'auto'; el.style.height = Math.min(el.scrollHeight, 240) + 'px'; }
function escapeHtml(s) { return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }

document.getElementById('chatArea').addEventListener('scroll', e => {
  const a = e.target;
  stickToBottom = a.scrollHeight - a.scrollTop - a.clientHeight < 80;
});
document.getElementById('prompt').addEventListener('input', e => autoResize(e.target));
document.getElementById('prompt').addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSend(); }
});

(async function init() {
  await refreshModels();
  try {
    const list = await api('GET', '/chats');
    chats = list.map(c => ({ ...c, messages: [], loaded: false }));
  } catch (e) { console.error('Could not load chats:', e); }
  newChat();
})();
</script>
</body>
</html>